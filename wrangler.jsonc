{
  // Sitio estático + una API chica para el catálogo de autos.
  //
  // ANTES ERA SOLO `assets` y ahora hay tambien un Worker. El orden
  // importa: con `main` presente, Cloudflare manda al script TODO lo que
  // no encuentre como archivo en public/. O sea que /, /garage y las
  // fotos siguen saliendo del disco —rapido y cacheado— y solo /api/* y
  // /admin pasan por codigo.
  //
  // `directory` apunta a public/ y no a la raiz a proposito: las fotos
  // originales (source/) y los scripts (tools/) quedan en el repo pero
  // fuera del sitio publicado.
  "name": "consecionario",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",

  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    // El Worker recibe lo que no sea un archivo estatico. Sin esto, un
    // pedido a /api/autos devolveria el 404 de assets y nunca llegaria
    // al codigo.
    "not_found_handling": "none",
    // /admin/panel.js NO va en esta lista: es codigo de cliente, no
    // tiene secretos y conviene que salga del disco cacheado. Solo
    // /admin —la pagina— pasa por el Worker, que es donde se avisa si
    // faltan los secretos.
    // El .html de Google entra a esta lista por un motivo puntual:
    // `auto-trailing-slash` le sacaria la extension y contestaria un
    // 307 en la direccion exacta que Google pide. Pasando por el
    // Worker, esa direccion devuelve 200 con el archivo.
    // /auto/* son las fichas: no hay ningun archivo en public/ con esa
    // direccion. Las arma el Worker sirviendo /garage/index.html con el
    // <head> reescrito, asi que tiene que pasar por codigo si o si.
    //
    // /sitemap.xml ESTABA EN public/ Y SE FUE. Ahora lista tambien cada
    // auto, y eso sale de la base: escrito a mano quedaria viejo el dia
    // que entre o salga una unidad.
    "run_worker_first": ["/api/*", "/admin", "/auto/*", "/sitemap.xml",
                         "/fotos/*", "/google6c566cd3264b21dc.html"],
    "binding": "ARCHIVOS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manna-autos",
      "database_id": "e601dfe5-9c7b-4953-92fa-2bcdf30bea0b"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FOTOS",
      "bucket_name": "manna-fotos"
    }
  ],

  // WHATSAPP: LOS DOS IDENTIFICADORES VAN ACA Y NO COMO SECRETOS. No
  // dan acceso a nada por si solos —sin el token no sirven— y tenerlos
  // escritos deja claro con que numero habla el sitio.
  //
  // ES EL NUMERO REAL DEL NEGOCIO, +54 9 11 7670-3813, EN COEXISTENCIA.
  // Coexistencia quiere decir que el numero sigue funcionando en la app
  // WhatsApp Business del celular —con su catalogo y sus chats— y ademas
  // contesta por la API. Antes habia que ser proveedor de tecnologia de
  // Meta para esto; desde el registro v5 viene activada sola.
  //
  // Se dejo de usar el numero de prueba de Meta: solo le podia escribir a
  // cinco telefonos anotados a mano y su token vencia cada 24 horas. No
  // servia para atender clientes y no queda escrito en ningun lado.
  //
  // EL TOKEN TIENE QUE SER DE USUARIO DEL SISTEMA, no el temporal de la
  // pantalla de pruebas: ese vence cada 24 horas y el bot se queda mudo.
  // Va como secreto con `wrangler secret put WHATSAPP_TOKEN`, nunca aca.
  "vars": {
    "WHATSAPP_PHONE_ID": "1336740542848389",
    "WHATSAPP_CUENTA_ID": "1784146802921826",
    // El WhatsApp de Maxi: el bot le consulta lo que no sabe, aprende de
    // lo que él le contesta y a las 21 le manda el repaso del día (ver
    // "MAXI, EL QUE ENSEÑA" en src/index.js). Lo que llega desde este
    // número no se contesta como a un cliente. Vacío, todo eso se apaga.
    "SUPERVISOR_WHATSAPP": "5491133762494"
  },

  // LA LIMPIEZA DE LAS CONVERSACIONES, UNA VEZ POR DIA.
  //
  // 04:30 UTC es la 01:30 de Argentina: nadie escribiendo y nadie
  // mirando el panel. Lo que hace esta corrida esta en el `scheduled`
  // de src/index.js y el plazo —12 meses— esta explicado en
  // esquema/008-conversaciones.sql.
  //
  // EL PLAZO ESTA DECLARADO ANTE META Y PUBLICADO EN /privacidad/. Si
  // alguna vez cambia, se cambian los tres lugares el mismo dia.
  // Cada media hora: refresca las estadisticas de Instagram de a tandas,
  // para que el panel este al dia sin que nadie entre. La limpieza de
  // conversaciones sigue siendo diaria y el propio codigo la corre solo
  // en la vuelta de las 4 (ver `scheduled` en src/index.js).
  // LA COLA DE ENVÍOS DEL BOT: manda una respuesta en partes, con pausas
  // de diez segundos, aunque nadie se quede esperando. Ver `Envios` en
  // src/index.js. La migración la crea la primera vez que se publica.
  "durable_objects": {
    "bindings": [{ "name": "ENVIOS", "class_name": "Envios" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Envios"] }],

  // WHISPER, EL DE CLOUDFLARE: pasa a texto los audios que mandan los
  // clientes, sin que el audio salga de Cloudflare. Ver transcribirAudios
  // en src/index.js.
  "ai": { "binding": "AI" },

  "triggers": { "crons": ["0,30 * * * *"] },

  "observability": { "enabled": true }
}
