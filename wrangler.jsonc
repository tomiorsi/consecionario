{
  // Sitio estático servido por Cloudflare Workers.
  //
  // Sin este archivo, Cloudflare no sabe que el repo es un sitio y
  // publica el Worker de ejemplo — el "Hello World" que aparecía.
  //
  // `directory` apunta a public/ y no a la raíz a propósito: las fotos
  // originales (source/) y el script de calibración (tools/) quedan en
  // el repo pero fuera del sitio publicado.
  "name": "consecionario",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash"
  }
}
